# Environment Variables Template for Mind.Maze
# Copy this to .env.local for local development, or add these keys to Vercel Project Settings

# Groq API Key (Required for AI Trivia, Crossword & Quiz)
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication Secret Key (Required for Auth signing)
JWT_SECRET=your_jwt_secret_key_here

# Vercel Blob Storage Token (Automatically injected by Vercel when Blob is connected)
# BLOB_READ_WRITE_TOKEN=
